+const fn symbol_for(control: Control, levels: StockLevels) -> Symbol {
+    match (control, levels.playing) {
+        (Control::MediaPlayPause, Some(true)) => Symbol::Pause,
+        (Control::MediaPlayPause, Some(false)) => Symbol::Play,
+        _ => control_symbol(control),
+    }
