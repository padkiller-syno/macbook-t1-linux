+impl Xrgb8888Frame<'_> {
+    /// Alpha-blends a straight-alpha RGBA image over a positive in-bounds rectangle.
+    ///
+    /// # Errors
+    ///
+    /// Returns [`FramebufferError::RectangleOutOfBounds`] when the rectangle
+    /// is empty or outside the frame, or when `rgba` is not `width * height * 4`.
+    pub fn blend_rgba(&mut self, rectangle: Rectangle, rgba: &[u8]) -> Result<(), FramebufferError> {
+        let width = usize::try_from(rectangle.width).unwrap_or(0);
+        if rgba.len() != width * usize::try_from(rectangle.height).unwrap_or(0) * 4 {
+            return Err(FramebufferError::RectangleOutOfBounds);
+        }
+        for (row, line) in (0..rectangle.height).zip(rgba.chunks_exact(width * 4)) {
+            for (column, pixel) in (0..rectangle.width).zip(line.chunks_exact(4)) {
+                if pixel[3] == 0 {
+                    continue;
+                }
+                self.blend_mask(
+                    Rectangle {
+                        x: rectangle.x + column,
+                        y: rectangle.y + row,
+                        width: 1,
+                        height: 1,
+                    },
+                    &pixel[3..4],
+                    Rgb {
+                        red: pixel[0],
+                        green: pixel[1],
+                        blue: pixel[2],
+                    },
+                )?;
+            }
+        }
+        Ok(())
+    }
+}
+
 fn blend_channel(background: u8, foreground: u8, alpha: u16) -> u8 {
     let inverse = 255 - alpha;
     u8::try_from((u16::from(background) * inverse + u16::from(foreground) * alpha + 127) / 255)
