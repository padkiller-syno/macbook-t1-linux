+/// Full-color launcher icon (straight-alpha RGBA), loaded at runtime.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct AppIcon {
+    pub width: u32,
+    pub height: u32,
+    pub rgba: Vec<u8>,
+}
+
+impl AppIcon {
+    /// Parses `width:u32le height:u32le` followed by RGBA rows.
+    #[must_use]
+    pub fn parse(bytes: &[u8]) -> Option<Self> {
+        let width = u32::from_le_bytes(bytes.get(0..4)?.try_into().ok()?);
+        let height = u32::from_le_bytes(bytes.get(4..8)?.try_into().ok()?);
+        let rgba = bytes.get(8..)?.to_vec();
+        let valid = (1..=NATIVE_PLATE_HEIGHT).contains(&width)
+            && (1..=NATIVE_PLATE_HEIGHT).contains(&height)
+            && rgba.len() == usize::try_from(width * height * 4).ok()?;
+        valid.then_some(Self {
+            width,
+            height,
+            rgba,
+        })
+    }
+}
+
+/// Centers a launcher icon in `bounds`, skipped when it does not fit.
+pub(crate) fn draw_app_icon(
+    frame: &mut Xrgb8888Frame<'_>,
+    bounds: Rectangle,
+    icon: &AppIcon,
+) -> Result<(), FramebufferError> {
+    if icon.width > bounds.width || icon.height > bounds.height {
+        return Ok(());
+    }
+    frame.blend_rgba(
+        Rectangle {
+            x: bounds.x + (bounds.width - icon.width) / 2,
+            y: bounds.y + (bounds.height - icon.height) / 2,
+            width: icon.width,
+            height: icon.height,
+        },
+        &icon.rgba,
+    )
+}
+
+/// Antialiased filled circle of `size` pixels.
+pub(crate) fn rounded_dot(size: u32) -> Vec<u8> {
+    let radius = f64::from(size) / 2.0;
+    rasterize(size, size, |x, y| {
+        let dx = x - radius;
+        let dy = y - radius;
+        dx * dx + dy * dy <= radius * radius
+    })
+}
+
+/// Lays `text` out in the embedded font as one alpha mask (`width`, pixels),
+/// cut with an ellipsis to fit `max_width`; unknown characters become `?`.
+pub(crate) fn text_mask(text: &str, max_width: u32) -> (u32, Vec<u8>) {
+    let glyph = |ch: char| {
+        crate::overlay_font::GLYPHS
+            .iter()
+            .find(|(c, _, _)| *c == ch)
+            .or_else(|| crate::overlay_font::GLYPHS.iter().find(|(c, _, _)| *c == '?'))
+            .map(|(_, width, pixels)| (*width, *pixels))
+    };
+    let mut glyphs: Vec<(u32, &[u8])> = text.chars().filter_map(glyph).collect();
+    let total = |glyphs: &[(u32, &[u8])]| glyphs.iter().map(|(width, _)| width).sum::<u32>();
+    if total(&glyphs) > max_width {
+        let ellipsis = glyph('…');
+        let room = max_width.saturating_sub(ellipsis.map_or(0, |(width, _)| width));
+        while !glyphs.is_empty() && total(&glyphs) > room {
+            glyphs.pop();
+        }
+        glyphs.extend(ellipsis);
+    }
+    let width = total(&glyphs);
+    let height = crate::overlay_font::LINE_HEIGHT;
+    let mut mask = vec![0_u8; usize::try_from(width * height).unwrap_or(0)];
+    let mut left = 0_u32;
+    for (glyph_width, pixels) in glyphs {
+        for row in 0..height {
+            for column in 0..glyph_width {
+                let source = usize::try_from(row * glyph_width + column).unwrap_or(0);
+                let target = usize::try_from(row * width + left + column).unwrap_or(0);
+                mask[target] = pixels[source];
+            }
+        }
+        left += glyph_width;
+    }
+    (width, mask)
+}
