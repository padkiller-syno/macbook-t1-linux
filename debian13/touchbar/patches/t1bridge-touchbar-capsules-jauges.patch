+    /// Touch ID context: each `pam_fprintd` try is its own overlay session, so the
+    /// miss count lives as long as the PAM request (same context timestamp).
+    fn track_touch_attempts(&mut self, previous: Option<OverlayState>, next: Option<OverlayState>) {
+        match next {
+            Some(OverlayState::Authenticate | OverlayState::Approve) if previous.is_none() => {
+                let context = load_touch_context();
+                let same_request = matches!(
+                    (&context, &self.touch_context),
+                    (Some(new), Some(old)) if new.timestamp == old.timestamp
+                );
+                if !same_request {
+                    self.touch_misses = 0;
+                }
+                self.touch_context = context;
+                self.touch_attempt_start = self.now;
+            }
+            Some(OverlayState::Authenticate | OverlayState::Approve) => {
+                self.touch_attempt_start = self.now;
+            }
+            Some(OverlayState::Retry) => {
+                self.touch_misses = self.touch_misses.saturating_add(1);
+                self.touch_attempt_start = self.now;
+            }
+            _ => {}
+        }
+    }
