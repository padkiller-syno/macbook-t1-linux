+/// What the PAM request is about, written by the `pam_exec` helper just before
+/// `pam_fprintd` (`key=value` lines: `ts`, `label`, `tries`, `timeout`).
+#[derive(Clone, Debug, Eq, PartialEq)]
+struct TouchIdContext {
+    timestamp: u64,
+    label: String,
+    tries: u8,
+    timeout: Duration,
+}
+
+/// Everything the Touch ID panel needs for one frame.
+struct TouchView {
+    context: TouchIdContext,
+    panel: crate::framebuffer::Rectangle,
+    state: OverlayState,
+    misses: u8,
+    timer: u32,
+    urgent: bool,
+    opacity: u8,
+}
+
+/// What is being authorized, remaining tries and time left for this try.
+fn draw_touch_context(
+    frame: &mut Xrgb8888Frame<'_>,
+    view: &TouchView,
+) -> Result<(), crate::framebuffer::FramebufferError> {
+    use crate::framebuffer::Rectangle;
+    let panel = view.panel;
+    let fade = |alpha: u8| {
+        u8::try_from((u16::from(alpha) * u16::from(view.opacity) + 127) / 255).unwrap_or(u8::MAX)
+    };
+    let live = view.state != OverlayState::Success;
+    let tries = view.context.tries;
+    // tries, right-aligned: lit = still available, dim = used (red right after a miss)
+    let dot = TOUCH_DOT_SIZE;
+    let dots_width = u32::from(tries) * (dot + TOUCH_DOT_GAP);
+    let mut text_right = panel.x + panel.width;
+    if live && tries > 0 && dots_width < panel.width {
+        let mask: Vec<u8> = crate::stock_art::rounded_dot(dot).iter().map(|a| fade(*a)).collect();
+        for index in 0..tries {
+            let used = index >= tries.saturating_sub(view.misses);
+            let color = match (used, view.state) {
+                (true, OverlayState::Retry) => TOUCH_MISS,
+                (true, _) => TOUCH_DIM,
+                (false, _) => TOUCH_TEXT,
+            };
+            frame.blend_mask(
+                Rectangle {
+                    x: panel.x + panel.width - dots_width + u32::from(index) * (dot + TOUCH_DOT_GAP),
+                    y: (panel.height - dot) / 2,
+                    width: dot,
+                    height: dot,
+                },
+                &mask,
+                color,
+            )?;
+        }
+        text_right = text_right.saturating_sub(dots_width + TOUCH_PANEL_MARGIN);
+    }
+    let (width, mask) =
+        crate::stock_art::text_mask(&view.context.label, text_right.saturating_sub(panel.x));
+    let height = crate::overlay_font::LINE_HEIGHT.min(panel.height);
+    if width > 0 {
+        let mask: Vec<u8> = mask.iter().map(|a| fade(*a)).collect();
+        frame.blend_mask(
+            Rectangle {
+                x: panel.x,
+                y: (panel.height - height) / 2,
+                width,
+                height,
+            },
+            &mask,
+            TOUCH_TEXT,
+        )?;
+    }
+    if live && view.state != OverlayState::Retry && view.timer > 0 {
+        frame.blend_rectangle(
+            Rectangle {
+                x: panel.x,
+                y: panel.height - TOUCH_TIMER_BOTTOM,
+                width: view.timer,
+                height: TOUCH_TIMER_HEIGHT,
+            },
+            if view.urgent { TOUCH_URGENT } else { TOUCH_DIM },
+            view.opacity,
+        )?;
+    }
+    Ok(())
+}
+
+const TOUCH_CONTEXT_PATH: &str = "/run/t1bridge/touch-id-context";
+/// A context older than this belongs to an earlier, finished request.
+const TOUCH_CONTEXT_MAX_AGE_S: u64 = 120;
+const TOUCH_PANEL_MARGIN: u32 = 24;
+const TOUCH_DOT_SIZE: u32 = 10;
+const TOUCH_DOT_GAP: u32 = 10;
+const TOUCH_TIMER_HEIGHT: u32 = 3;
+const TOUCH_TIMER_BOTTOM: u32 = 9;
+const TOUCH_TEXT: crate::framebuffer::Rgb = crate::framebuffer::Rgb {
+    red: 220,
+    green: 220,
+    blue: 224,
+};
+const TOUCH_DIM: crate::framebuffer::Rgb = crate::framebuffer::Rgb {
+    red: 90,
+    green: 90,
+    blue: 96,
+};
+const TOUCH_MISS: crate::framebuffer::Rgb = crate::framebuffer::Rgb {
+    red: 255,
+    green: 69,
+    blue: 58,
+};
+const TOUCH_URGENT: crate::framebuffer::Rgb = crate::framebuffer::Rgb {
+    red: 255,
+    green: 159,
+    blue: 10,
+};
+
+fn load_touch_context() -> Option<TouchIdContext> {
+    if cfg!(test) {
+        return None;
+    }
+    let bytes = std::fs::read(TOUCH_CONTEXT_PATH).ok()?;
+    if bytes.len() > 1_024 {
+        return None;
+    }
+    let text = String::from_utf8_lossy(&bytes);
+    let mut context = TouchIdContext {
+        timestamp: 0,
+        label: String::new(),
+        tries: 3,
+        timeout: Duration::from_secs(30),
+    };
+    for line in text.lines() {
+        match line.split_once('=') {
+            Some(("ts", value)) => context.timestamp = value.parse().ok()?,
+            Some(("label", value)) => {
+                context.label = value.chars().filter(|ch| !ch.is_control()).take(200).collect();
+            }
+            Some(("tries", value)) => context.tries = value.parse::<u8>().ok()?.min(10),
+            Some(("timeout", value)) => {
+                context.timeout = Duration::from_secs(value.parse::<u64>().ok()?.clamp(1, 600));
+            }
+            _ => {}
+        }
+    }
+    let now = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .ok()?
+        .as_secs();
+    (now.saturating_sub(context.timestamp) <= TOUCH_CONTEXT_MAX_AGE_S && !context.label.is_empty())
+        .then_some(context)
+}
+
+/// Launcher icons: `N.rgba` (0, 1, …) written by `t1-touchbar-apps`; none in tests.
+fn app_icon_dir() -> Option<std::path::PathBuf> {
+    if cfg!(test) {
+        return None;
+    }
+    let cache = std::env::var_os("XDG_CACHE_HOME")
+        .map(std::path::PathBuf::from)
+        .or_else(|| std::env::var_os("HOME").map(|home| std::path::Path::new(&home).join(".cache")))?;
+    Some(cache.join("t1bridge/apps"))
+}
+
+fn app_icon_count() -> usize {
+    let Some(dir) = app_icon_dir() else {
+        return 0;
+    };
+    (0..usize::from(u8::MAX))
+        .take_while(|index| dir.join(format!("{index}.rgba")).is_file())
+        .count()
+}
+
+fn load_app_icons() -> Vec<AppIcon> {
+    let Some(dir) = app_icon_dir() else {
+        return Vec::new();
+    };
+    (0..app_icon_count())
+        .map_while(|index| {
+            std::fs::read(dir.join(format!("{index}.rgba")))
+                .ok()
+                .and_then(|bytes| AppIcon::parse(&bytes))
+        })
+        .collect()
+}
+
+/// Last polled MPRIS position, extrapolated at normal rate while playing.
+#[derive(Clone, Copy, Debug)]
+struct TrackClock {
+    position_ms: u64,
+    length_ms: u64,
+    at: Duration,
+}
+
+impl TrackClock {
+    fn permille(self, now: Duration, playing: bool) -> u16 {
+        let elapsed = if playing {
+            u64::try_from(now.saturating_sub(self.at).as_millis()).unwrap_or(u64::MAX)
+        } else {
+            0
+        };
+        let position = self.position_ms.saturating_add(elapsed).min(self.length_ms);
+        u16::try_from(position * 1_000 / self.length_ms).unwrap_or(1_000)
+    }
+}
+
+fn step_level(level: Option<u8>, direction: StepDirection, step: u8) -> Option<u8> {
