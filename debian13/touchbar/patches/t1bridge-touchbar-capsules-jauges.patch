+
+/// Last polled MPRIS position, extrapolated at normal rate while playing.
+#[derive(Clone, Copy, Debug)]
+struct TrackClock {
+    position_ms: u64,
+    length_ms: u64,
+    at: Duration,
+}
+
+impl TrackClock {
+    fn permille(self, now: Duration, playing: bool) -> u16 {
+        let elapsed = if playing {
+            u64::try_from(now.saturating_sub(self.at).as_millis()).unwrap_or(u64::MAX)
+        } else {
+            0
+        };
+        let position = self.position_ms.saturating_add(elapsed).min(self.length_ms);
+        u16::try_from(position * 1_000 / self.length_ms).unwrap_or(1_000)
+    }
+}
+
+fn step_level(level: Option<u8>, direction: StepDirection, step: u8) -> Option<u8> {
+    level.map(|level| match direction {
+        StepDirection::Down => level.saturating_sub(step),
+        StepDirection::Up => level.saturating_add(step).min(100),
+    })
+}
+
+/// Moves a third of the remaining distance (at least one unit) per frame.
+fn ease_level(shown: Option<u8>, target: Option<u8>) -> Option<u8> {
+    match (shown, target) {
+        (Some(shown), Some(target)) if shown != target => {
+            let distance = i16::from(target) - i16::from(shown);
+            let next = i16::from(shown) + distance / 3 + distance.signum();
+            Some(u8::try_from(next).unwrap_or(target))
+        }
+        _ => target,
+    }
+}
