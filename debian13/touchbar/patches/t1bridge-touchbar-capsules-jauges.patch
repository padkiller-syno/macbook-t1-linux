+const fn label_color(control: Control, levels: StockLevels) -> Rgb {
+    match control {
+        Control::Mute if levels.muted => MUTED_LABEL,
+        Control::Mute | Control::VolumeDown | Control::VolumeUp if levels.external_output => {
+            EXTERNAL_OUTPUT_LABEL
+        }
+        Control::DisplayDown | Control::DisplayUp if levels.night_light => NIGHT_LIGHT_LABEL,
+        Control::KeyboardDown | Control::KeyboardUp
+            if matches!(levels.keyboard_backlight, Some(0)) =>
+        {
+            BACKLIGHT_OFF_LABEL
+        }
+        _ => LABEL,
+    }
+}
