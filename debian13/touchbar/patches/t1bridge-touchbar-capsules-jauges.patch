+        return Some((progress, PROGRESS_FILL));
+    }
+    let (level, fill) = match head {
+        Control::DisplayDown => (levels.display_brightness, GAUGE_FILL),
+        Control::KeyboardDown => (levels.keyboard_backlight, GAUGE_FILL),
+        Control::Mute => (
+            levels.volume,
+            match levels.volume {
+                _ if levels.muted => MUTED_LABEL,
+                Some(volume) if volume > LOUD_VOLUME_PERCENT => LOUD_GAUGE_FILL,
+                _ => GAUGE_FILL,
+            },
+        ),
+        _ => (None, GAUGE_FILL),
+    };
+    match level {
+        Some(level) => Some((level as u16 * 10, fill)),
+        None => None,
+    }
+}
