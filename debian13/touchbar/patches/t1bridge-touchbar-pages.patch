@@ -0,0 +1,20 @@
+//! Prints the native desktop status every second, for comparison with the
+//! provider script: `cargo run -p t1-touchbar --example native_status -- 10`
+use std::time::{Duration, Instant};
+
+use t1_touchbar::native_status::NativeStatus;
+
+fn main() {
+    let seconds: u64 = std::env::args().nth(1).and_then(|arg| arg.parse().ok()).unwrap_or(5);
+    let Some(mut native) = NativeStatus::start() else {
+        eprintln!("native status unavailable");
+        std::process::exit(1);
+    };
+    std::thread::sleep(Duration::from_millis(300));
+    for _ in 0..seconds {
+        let started = Instant::now();
+        let state = native.status();
+        println!("{:>5} µs {state:?}", started.elapsed().as_micros());
+        std::thread::sleep(Duration::from_secs(1));
+    }
+}
