+    /// Icon then text, centred together in `bounds`.
+    fn draw_icon_and_label(
+        self,
+        frame: &mut Xrgb8888Frame<'_>,
+        bounds: Rectangle,
+        symbol: Symbol,
+        text: &str,
+        color: Rgb,
+    ) -> Result<(), StockSliceError> {
+        let icon = self.scaled_x(44).min(bounds.width);
+        let (text_width, _) = stock_art::text_mask(text, bounds.width.saturating_sub(icon));
+        let total = icon + text_width;
+        let left = bounds.x + bounds.width.saturating_sub(total) / 2;
+        stock_art::draw_symbol(
+            frame,
+            Rectangle {
+                x: left,
+                width: icon,
+                ..bounds
+            },
+            symbol,
+            color,
+        )?;
+        stock_art::draw_text(
+            frame,
+            Rectangle {
+                x: left + icon,
+                width: text_width.max(1),
+                ..bounds
+            },
+            text,
+            color,
+            Align::Left,
+        )?;
+        Ok(())
+    }
