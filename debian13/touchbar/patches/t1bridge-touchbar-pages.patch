diff --git a/crates/t1-touchbar/src/system_info.rs b/crates/t1-touchbar/src/system_info.rs
new file mode 100644
index 0000000..22b8c39
--- /dev/null
+++ b/crates/t1-touchbar/src/system_info.rs
@@ -0,0 +1,255 @@
+//! System readings for the Touch Bar system meter and page: CPU load (with a
+//! short history), CPU package temperature, fan speed, memory, battery and the
+//! Radeon power level. Everything is read straight from `/proc` and `/sys`
+//! once per second by the renderer: no helper process is spawned.
+
+use std::collections::VecDeque;
+use std::fs;
+use std::path::{Path, PathBuf};
+
+/// Samples kept for the CPU history (one per second).
+pub const HISTORY: usize = 48;
+
+/// Battery reading, as GNOME shows it (charge relative to the current full capacity).
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub struct Battery {
+    pub percent: u8,
+    /// Power in tenths of a watt, into the battery when charging, out of it otherwise.
+    pub deciwatts: u32,
+    pub charging: bool,
+    pub on_battery: bool,
+}
+
+/// Latest readings; fields are `None` when the source is missing or unreadable.
+#[derive(Clone, Debug, Default, Eq, PartialEq)]
+pub struct SystemInfo {
+    /// CPU load in tenths of a percent (0..=1000), oldest first.
+    pub cpu_history: VecDeque<u16>,
+    pub temperature_c: Option<u16>,
+    pub fan_rpm: Option<u32>,
+    /// Used and total memory in MiB.
+    pub memory_mib: Option<(u32, u32)>,
+    pub battery: Option<Battery>,
+    /// `power_dpm_force_performance_level` of the Radeon (`low`, `high`, `auto`…).
+    pub gpu_level: Option<String>,
+    /// Radeon power in tenths of a watt.
+    pub gpu_deciwatts: Option<u32>,
+}
+
+impl SystemInfo {
+    /// Latest CPU load in tenths of a percent.
+    #[must_use]
+    pub fn cpu(&self) -> Option<u16> {
+        self.cpu_history.back().copied()
+    }
+}
+
+/// Reads the sources found at start-up; cheap enough to call every second.
+#[derive(Debug, Default)]
+pub struct SystemSampler {
+    previous_cpu: Option<CpuTimes>,
+    temperature: Option<PathBuf>,
+    fan: Option<PathBuf>,
+    gpu_power: Option<PathBuf>,
+    gpu_level: Option<PathBuf>,
+    battery: Option<PathBuf>,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+struct CpuTimes {
+    idle: u64,
+    total: u64,
+}
+
+impl SystemSampler {
+    /// Locates the sensors once (hwmon numbering changes between boots).
+    #[must_use]
+    pub fn discover() -> Self {
+        let mut sampler = Self::default();
+        if let Ok(entries) = fs::read_dir("/sys/class/hwmon") {
+            for entry in entries.flatten() {
+                let dir = entry.path();
+                let Ok(name) = fs::read_to_string(dir.join("name")) else {
+                    continue;
+                };
+                match name.trim() {
+                    "coretemp" => sampler.temperature = Some(dir.join("temp1_input")),
+                    "applesmc" => sampler.fan = Some(dir.join("fan1_input")),
+                    "amdgpu" => sampler.gpu_power = Some(dir.join("power1_input")),
+                    _ => {}
+                }
+            }
+        }
+        let smc_fan = Path::new("/sys/devices/platform/applesmc.768/fan1_input");
+        if sampler.fan.is_none() && smc_fan.exists() {
+            sampler.fan = Some(smc_fan.to_path_buf());
+        }
+        if let Ok(entries) = fs::read_dir("/sys/class/drm") {
+            for entry in entries.flatten() {
+                let device = entry.path().join("device");
+                let level = device.join("power_dpm_force_performance_level");
+                let vendor = fs::read_to_string(device.join("vendor")).unwrap_or_default();
+                if vendor.trim() == "0x1002" && level.exists() {
+                    sampler.gpu_level = Some(level);
+                    break;
+                }
+            }
+        }
+        let battery = Path::new("/sys/class/power_supply/BAT0");
+        if battery.exists() {
+            sampler.battery = Some(battery.to_path_buf());
+        }
+        sampler
+    }
+
+    /// Takes one reading into `info`; the first call only primes the CPU counters.
+    pub fn sample(&mut self, info: &mut SystemInfo) {
+        if let Some(times) = fs::read_to_string("/proc/stat")
+            .ok()
+            .and_then(|text| parse_proc_stat(&text))
+        {
+            if let Some(load) = self.previous_cpu.and_then(|previous| cpu_percent(previous, times)) {
+                if info.cpu_history.len() == HISTORY {
+                    info.cpu_history.pop_front();
+                }
+                info.cpu_history.push_back(load);
+            }
+            self.previous_cpu = Some(times);
+        }
+        info.temperature_c = self
+            .temperature
+            .as_deref()
+            .and_then(read_number)
+            .and_then(|milli| u16::try_from((milli + 500) / 1_000).ok());
+        info.fan_rpm = self
+            .fan
+            .as_deref()
+            .and_then(read_number)
+            .and_then(|rpm| u32::try_from(rpm).ok());
+        info.memory_mib = fs::read_to_string("/proc/meminfo")
+            .ok()
+            .and_then(|text| parse_meminfo(&text));
+        info.gpu_deciwatts = self
+            .gpu_power
+            .as_deref()
+            .and_then(read_number)
+            .and_then(|micro| u32::try_from((micro + 50_000) / 100_000).ok());
+        info.gpu_level = self
+            .gpu_level
+            .as_deref()
+            .and_then(|path| fs::read_to_string(path).ok())
+            .map(|level| level.trim().to_owned());
+        info.battery = self.battery.as_deref().and_then(read_battery);
+    }
+}
+
+fn read_number(path: &Path) -> Option<i64> {
+    fs::read_to_string(path).ok()?.trim().parse().ok()
+}
+
+fn read_battery(dir: &Path) -> Option<Battery> {
+    let number = |name: &str| read_number(&dir.join(name));
+    let status = fs::read_to_string(dir.join("status")).unwrap_or_default();
+    let percent = match (number("charge_now"), number("charge_full")) {
+        (Some(now), Some(full)) if full > 0 => (now * 100 + full / 2) / full,
+        _ => number("capacity")?,
+    };
+    let deciwatts = match (number("current_now"), number("voltage_now")) {
+        // µA × µV = 10⁻¹² W ; tenths of a watt = / 10¹¹
+        (Some(current), Some(voltage)) => (current.unsigned_abs() as u128 * voltage.unsigned_abs() as u128
+            + 50_000_000_000)
+            / 100_000_000_000,
+        _ => 0,
+    };
+    let online = fs::read_to_string("/sys/class/power_supply/ADP1/online")
+        .map(|text| text.trim() == "1")
+        .unwrap_or(false);
+    Some(Battery {
+        percent: u8::try_from(percent.clamp(0, 100)).unwrap_or(100),
+        deciwatts: u32::try_from(deciwatts).unwrap_or(u32::MAX),
+        charging: status.trim() == "Charging",
+        on_battery: !online,
+    })
+}
+
+/// Aggregate `cpu` line of `/proc/stat`: idle (idle + iowait) and total jiffies.
+fn parse_proc_stat(text: &str) -> Option<CpuTimes> {
+    let line = text.lines().find(|line| line.starts_with("cpu "))?;
+    let values: Vec<u64> = line
+        .split_ascii_whitespace()
+        .skip(1)
+        .take(8)
+        .map(str::parse)
+        .collect::<Result<_, _>>()
+        .ok()?;
+    if values.len() < 5 {
+        return None;
+    }
+    Some(CpuTimes {
+        idle: values[3] + values[4],
+        total: values.iter().sum(),
+    })
+}
+
+/// Load between two readings, in tenths of a percent.
+fn cpu_percent(previous: CpuTimes, current: CpuTimes) -> Option<u16> {
+    let total = current.total.checked_sub(previous.total)?;
+    let idle = current.idle.checked_sub(previous.idle)?;
+    if total == 0 {
+        return None;
+    }
+    let busy = total.saturating_sub(idle);
+    u16::try_from((busy * 1_000 + total / 2) / total).ok()
+}
+
+/// Used (`MemTotal - MemAvailable`) and total memory, in MiB.
+fn parse_meminfo(text: &str) -> Option<(u32, u32)> {
+    let field = |name: &str| {
+        text.lines()
+            .find(|line| line.starts_with(name))?
+            .split_ascii_whitespace()
+            .nth(1)?
+            .parse::<u64>()
+            .ok()
+    };
+    let total = field("MemTotal:")?;
+    let available = field("MemAvailable:")?;
+    let mib = |kib: u64| u32::try_from(kib / 1_024).ok();
+    Some((mib(total.saturating_sub(available))?, mib(total)?))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn cpu_load_comes_from_the_aggregate_line_difference() {
+        let first = parse_proc_stat("cpu  100 0 100 700 100 0 0 0 0 0\ncpu0 1 2 3 4\n").unwrap();
+        let second = parse_proc_stat("cpu  150 0 150 750 150 0 0 0 0 0\n").unwrap();
+        assert_eq!(first, CpuTimes { idle: 800, total: 1_000 });
+        // 200 jiffies elapsed, 100 of them idle or iowait
+        assert_eq!(cpu_percent(first, second), Some(500));
+        assert_eq!(cpu_percent(second, first), None);
+        assert_eq!(cpu_percent(first, first), None);
+    }
+
+    #[test]
+    fn memory_use_is_total_minus_available() {
+        let text = "MemTotal:       16000000 kB\nMemFree:  1 kB\nMemAvailable:    9856000 kB\n";
+        assert_eq!(parse_meminfo(text), Some((6_000, 15_625)));
+        assert_eq!(parse_meminfo("MemTotal: 5 kB\n"), None);
+    }
+
+    #[test]
+    fn history_is_bounded() {
+        let mut info = SystemInfo::default();
+        for value in 0..200_u16 {
+            if info.cpu_history.len() == HISTORY {
+                info.cpu_history.pop_front();
+            }
+            info.cpu_history.push_back(value);
+        }
+        assert_eq!(info.cpu_history.len(), HISTORY);
+        assert_eq!(info.cpu(), Some(199));
+    }
+}
