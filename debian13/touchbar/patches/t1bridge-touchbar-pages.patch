+    /// Launcher page: one capsule, a separated slot per configured application.
+    fn render_apps(
+        self,
+        frame: &mut Xrgb8888Frame<'_>,
+        pressed: Option<StockAction>,
+        apps: &[AppIcon],
+    ) -> Result<(), StockSliceError> {
+        let first = self.app_slot(0);
+        let last = self.app_slot(self.app_count.saturating_sub(1));
+        stock_art::draw_gradient_plate(
+            frame,
+            Rectangle {
+                width: last.x + last.width - first.x,
+                ..first
+            },
+            self.scaled_y(CAPSULE_RADIUS).max(1),
+            PLATE_TOP,
+            PLATE_BOTTOM,
+        )?;
+        for index in 0..self.app_count {
+            let slot = self.app_slot(index);
+            if index > 0 {
+                self.draw_separator(frame, slot)?;
+            }
+            if pressed == Some(StockAction::LaunchApp(index)) {
+                let inset = self.scaled_y(PRESSED_INSET);
+                stock_art::draw_gradient_plate(
+                    frame,
+                    Rectangle {
+                        x: slot.x + inset,
+                        y: slot.y + inset,
+                        width: slot.width.saturating_sub(2 * inset).max(1),
+                        height: slot.height.saturating_sub(2 * inset).max(1),
+                    },
+                    self.scaled_y(CAPSULE_RADIUS - PRESSED_INSET).max(1),
+                    PRESSED_TOP,
+                    PRESSED_BOTTOM,
+                )?;
+            }
+            if let Some(icon) = apps.get(usize::from(index)) {
+                stock_art::draw_app_icon(frame, slot, icon)?;
+            }
+        }
+        Ok(())
+    }
