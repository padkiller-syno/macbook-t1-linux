+    /// Slider: track, filled part and a round knob at the level.
+    fn draw_slider(
+        self,
+        frame: &mut Xrgb8888Frame<'_>,
+        bounds: Rectangle,
+        level: Option<u8>,
+        fill: Rgb,
+    ) -> Result<(), StockSliceError> {
+        let area = self.slider_track(bounds);
+        let height = self.scaled_y(SLIDER_TRACK_HEIGHT).max(2);
+        let track = Rectangle {
+            y: bounds.y + (bounds.height - height) / 2,
+            height,
+            ..area
+        };
+        stock_art::draw_gradient_plate(frame, track, height / 2, SLIDER_TRACK, SLIDER_TRACK)?;
+        let Some(level) = level else {
+            return Ok(());
+        };
+        let filled = track.width * u32::from(level.min(100)) / 100;
+        if filled > 0 {
+            stock_art::draw_gradient_plate(
+                frame,
+                Rectangle {
+                    width: filled.max(height),
+                    ..track
+                },
+                height / 2,
+                fill,
+                fill,
+            )?;
+        }
+        let knob = self.scaled_y(SLIDER_KNOB).max(4);
+        let centre = track.x + filled;
+        stock_art::draw_gradient_plate(
+            frame,
+            Rectangle {
+                x: centre.saturating_sub(knob / 2).max(bounds.x),
+                y: bounds.y + (bounds.height - knob) / 2,
+                width: knob,
+                height: knob,
+            },
+            knob / 2,
+            LABEL,
+            LABEL,
+        )?;
+        Ok(())
+    }
