+    /// CPU history as bars, newest on the right, coloured by load, on a square-root
+    /// scale so that light loads stay readable.
+    fn draw_history(
+        self,
+        frame: &mut Xrgb8888Frame<'_>,
+        area: Rectangle,
+        system: &SystemInfo,
+        gap: u32,
+    ) -> Result<(), StockSliceError> {
+        let top = self.scaled_y(12);
+        let height = self.scaled_y(36).max(1);
+        let slot = (area.width / u32::try_from(HISTORY).unwrap_or(1)).max(1);
+        let bar = slot.saturating_sub(gap).max(1);
+        let right = area.x + area.width;
+        for (age, load) in system.cpu_history.iter().rev().enumerate() {
+            let offset = slot * (u32::try_from(age).unwrap_or(u32::MAX) + 1);
+            if offset > area.width {
+                break;
+            }
+            // square-root scale: 1 % → 10 % of the height, 5 % → 22 %, 25 % → 50 %
+            let level = u32::from((*load).min(1_000)) * 1_000;
+            let bar_height = (height * level.isqrt() / 1_000).max(2);
+            let color = match *load {
+                0..=599 => PROGRESS_FILL,
+                600..=849 => LOUD_GAUGE_FILL,
+                _ => LOAD_HIGH,
+            };
+            frame.fill_rectangle(
+                Rectangle {
+                    x: right - offset,
+                    y: area.y + top + height - bar_height,
+                    width: bar,
+                    height: bar_height,
+                },
+                color,
+            )?;
+        }
+        Ok(())
+    }
