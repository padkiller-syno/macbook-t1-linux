+enum t1_seqpacket_status t1_seqpacket_wait_readable(int client_descriptor,
+	int timeout_ms, int *ready)
+{
+	struct pollfd descriptor;
+	int result;
+
+	if (ready == NULL || client_descriptor < 0 || timeout_ms < 0)
+		return T1_SEQPACKET_INVALID_ARGUMENT;
+	*ready = 0;
+	memset(&descriptor, 0, sizeof(descriptor));
+	descriptor.fd = client_descriptor;
+	descriptor.events = POLLIN;
+	result = poll(&descriptor, 1, timeout_ms);
+	if (result < 0)
+		return errno == EINTR ? T1_SEQPACKET_OK
+			: transient_status(errno, T1_SEQPACKET_READINESS_FAILED);
+	*ready = descriptor.revents != 0;
+	return T1_SEQPACKET_OK;
+}
