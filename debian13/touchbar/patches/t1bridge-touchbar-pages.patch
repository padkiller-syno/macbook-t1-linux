@@ -0,0 +1,527 @@
+//! Native desktop status for the MacBookPro13,3 (GNOME + PipeWire), replacing the
+//! provider script's `status` operation that used to be spawned every second.
+//!
+//! - audio: a PulseAudio-protocol client (`pipewire-pulse`); one connection is
+//!   subscribed to sink/source/server events and wakes only when they change, a
+//!   second one answers the queries;
+//! - D-Bus (`zbus`): one session connection kept open, short call timeout: display
+//!   power (Mutter), MPRIS player, Night Light;
+//! - display and keyboard backlight levels: read from sysfs;
+//! - GNOME settings (automatic brightness, EasyEffects bypass): read with `gsettings`
+//!   only when the dconf database file changes;
+//! - calls: an application recording from the microphone (its stream), and the
+//!   virtual camera state written by `facetime-auto` in `$XDG_RUNTIME_DIR`.
+//!
+//! Any missing piece makes [`NativeStatus::status`] return `None`, and the caller
+//! falls back to the provider script. Actions stay in the script: they only run on
+//! a key press.
+
+use std::collections::HashMap;
+use std::ffi::CString;
+use std::io::BufReader;
+use std::os::unix::net::UnixStream;
+use std::path::{Path, PathBuf};
+use std::process::Command as Process;
+use std::sync::{Arc, Mutex};
+use std::thread;
+use std::time::{Duration, Instant, SystemTime};
+
+use pulseaudio::protocol::{self, Command, Prop, SubscriptionMask};
+use zbus::blocking::Connection;
+use zbus::blocking::fdo::{DBusProxy, PropertiesProxy};
+use zbus::names::InterfaceName;
+use zbus::zvariant::OwnedValue;
+
+use crate::desktop_provider::{DesktopCapabilities, DesktopState, OutputKind};
+use crate::stock_slice::CallApp;
+
+const DBUS_TIMEOUT: Duration = Duration::from_millis(300);
+const PLAYER_LIST_TTL: Duration = Duration::from_secs(5);
+const AUDIO_RETRY: Duration = Duration::from_secs(2);
+const DISPLAY_BACKLIGHT: &str = "/sys/class/backlight/gmux_backlight";
+const KEYBOARD_BACKLIGHT: &str = "/sys/class/leds/spi::kbd_backlight";
+const PLAYER_PATH: &str = "/org/mpris/MediaPlayer2";
+const PLAYER_INTERFACE: &str = "org.mpris.MediaPlayer2.Player";
+
+/// Default sink and source, as last reported by the sound server.
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+struct AudioState {
+    volume: u8,
+    muted: bool,
+    mic_muted: Option<bool>,
+    kind: OutputKind,
+    /// EasyEffects is running (its virtual sink exists).
+    effects_present: bool,
+    /// Application recording from the microphone.
+    call: Option<CallApp>,
+}
+
+#[derive(Debug, Default)]
+struct SettingsCache {
+    stamp: Option<SystemTime>,
+    auto_brightness: Option<bool>,
+    effects_bypassed: Option<bool>,
+}
+
+/// Status source kept alive for the renderer's lifetime.
+pub struct NativeStatus {
+    audio: Arc<Mutex<Option<AudioState>>>,
+    bus: Connection,
+    player: Option<String>,
+    player_checked: Option<Instant>,
+    settings: SettingsCache,
+    dconf: PathBuf,
+    runtime: Option<PathBuf>,
+}
+
+impl NativeStatus {
+    /// Connects to the session bus and starts the audio thread; `None` when the
+    /// session bus or the sound server socket is unavailable.
+    #[must_use]
+    pub fn start() -> Option<Self> {
+        pulseaudio::socket_path_from_env()?;
+        let bus = zbus::blocking::connection::Builder::session()
+            .ok()?
+            .method_timeout(DBUS_TIMEOUT)
+            .build()
+            .ok()?;
+        let audio = Arc::new(Mutex::new(None));
+        let shared = Arc::clone(&audio);
+        thread::Builder::new()
+            .name("t1-native-audio".into())
+            .spawn(move || audio_thread(&shared))
+            .ok()?;
+        let config = std::env::var_os("XDG_CONFIG_HOME")
+            .map(PathBuf::from)
+            .or_else(|| std::env::var_os("HOME").map(|home| PathBuf::from(home).join(".config")))?;
+        Some(Self {
+            audio,
+            bus,
+            player: None,
+            player_checked: None,
+            settings: SettingsCache::default(),
+            dconf: config.join("dconf/user"),
+            runtime: std::env::var_os("XDG_RUNTIME_DIR").map(PathBuf::from),
+        })
+    }
+
+    /// Current desktop state, or `None` while the sound server is not answering
+    /// (the caller then asks the provider script).
+    pub fn status(&mut self) -> Option<DesktopState> {
+        let audio = (*self.audio.lock().ok()?)?;
+        self.refresh_settings();
+        let mut capabilities = DesktopCapabilities::AUDIO
+            | DesktopCapabilities::LEVEL_FEEDBACK
+            | DesktopCapabilities::DISPLAY_POWER;
+        let mut state = DesktopState {
+            volume: Some(audio.volume),
+            muted: audio.muted,
+            display_off: self.display_off(),
+            display_brightness: backlight_percent(Path::new(DISPLAY_BACKLIGHT)),
+            keyboard_backlight: backlight_percent(Path::new(KEYBOARD_BACKLIGHT)),
+            external_output: audio.kind != OutputKind::Speakers,
+            night_light: self.night_light(),
+            auto_brightness: Some(self.settings.auto_brightness.unwrap_or(true)),
+            mic_muted: audio.mic_muted,
+            output_kind: Some(audio.kind),
+            effects: audio
+                .effects_present
+                .then_some(self.settings.effects_bypassed.map(|bypassed| !bypassed))
+                .flatten(),
+            call: audio.call,
+            camera_live: self.camera_live(),
+            camera_blocked: self
+                .runtime
+                .as_ref()
+                .is_some_and(|dir| dir.join("facetime-auto.off").exists()),
+            ..DesktopState::default()
+        };
+        if self.player_state(&mut state) {
+            capabilities = capabilities | DesktopCapabilities::MEDIA;
+        }
+        state.capabilities = capabilities;
+        Some(state)
+    }
+
+    fn property(&self, destination: &str, path: &str, interface: &str, name: &str) -> Option<OwnedValue> {
+        let proxy = PropertiesProxy::builder(&self.bus)
+            .destination(destination)
+            .ok()?
+            .path(path)
+            .ok()?
+            .cache_properties(zbus::proxy::CacheProperties::No)
+            .build()
+            .ok()?;
+        proxy
+            .get(InterfaceName::try_from(interface).ok()?, name)
+            .ok()
+    }
+
+    /// `facetime-auto` writes `camera` while it feeds the real camera.
+    fn camera_live(&self) -> bool {
+        self.runtime
+            .as_ref()
+            .and_then(|dir| std::fs::read_to_string(dir.join("facetime-auto.state")).ok())
+            .is_some_and(|state| state.trim() == "camera")
+    }
+
+    /// Mutter reports the desktop display powered down (`PowerSaveMode` ≠ 0).
+    fn display_off(&self) -> bool {
+        self.property(
+            "org.gnome.Mutter.DisplayConfig",
+            "/org/gnome/Mutter/DisplayConfig",
+            "org.gnome.Mutter.DisplayConfig",
+            "PowerSaveMode",
+        )
+        .and_then(|value| i32::try_from(value).ok())
+        .is_some_and(|mode| mode != 0)
+    }
+
+    fn night_light(&self) -> bool {
+        self.property(
+            "org.gnome.SettingsDaemon.Color",
+            "/org/gnome/SettingsDaemon/Color",
+            "org.gnome.SettingsDaemon.Color",
+            "NightLightActive",
+        )
+        .and_then(|value| bool::try_from(value).ok())
+        .unwrap_or(false)
+    }
+
+    /// First MPRIS player on the bus (list re-read every few seconds), with its
+    /// playback state and track position. Returns whether a player answered.
+    fn player_state(&mut self, state: &mut DesktopState) -> bool {
+        let stale = self
+            .player_checked
+            .is_none_or(|at| at.elapsed() >= PLAYER_LIST_TTL);
+        if stale || self.player.is_none() && self.player_checked.is_none() {
+            self.player = DBusProxy::new(&self.bus)
+                .ok()
+                .and_then(|proxy| proxy.list_names().ok())
+                .and_then(|names| {
+                    names
+                        .into_iter()
+                        .map(|name| name.to_string())
+                        .find(|name| name.starts_with("org.mpris.MediaPlayer2."))
+                });
+            self.player_checked = Some(Instant::now());
+        }
+        let Some(player) = self.player.clone() else {
+            return false;
+        };
+        let Some(status) = self
+            .property(&player, PLAYER_PATH, PLAYER_INTERFACE, "PlaybackStatus")
+            .and_then(|value| String::try_from(value).ok())
+        else {
+            // player gone: look again on the next poll
+            self.player = None;
+            self.player_checked = None;
+            return false;
+        };
+        state.playing = match status.as_str() {
+            "Playing" => Some(true),
+            "Paused" | "Stopped" => Some(false),
+            _ => None,
+        };
+        let position = self
+            .property(&player, PLAYER_PATH, PLAYER_INTERFACE, "Position")
+            .and_then(|value| i64::try_from(value).ok())
+            .and_then(|micros| u64::try_from(micros).ok());
+        let length = self
+            .property(&player, PLAYER_PATH, PLAYER_INTERFACE, "Metadata")
+            .and_then(|value| HashMap::<String, OwnedValue>::try_from(value).ok())
+            .and_then(|metadata| metadata.get("mpris:length").and_then(track_length));
+        if let (Some(position), Some(length)) = (position, length)
+            && length > 0
+        {
+            state.track_position_ms = Some(position / 1_000);
+            state.track_length_ms = Some(length / 1_000);
+        }
+        true
+    }
+
+    /// Re-reads the GNOME settings only when the dconf database was written.
+    fn refresh_settings(&mut self) {
+        let stamp = std::fs::metadata(&self.dconf).and_then(|meta| meta.modified()).ok();
+        if stamp.is_some() && stamp == self.settings.stamp {
+            return;
+        }
+        self.settings.stamp = stamp;
+        self.settings.auto_brightness =
+            gsettings_flag("org.gnome.settings-daemon.plugins.power", "ambient-enabled");
+        self.settings.effects_bypassed = gsettings_flag("com.github.wwmm.easyeffects", "bypass");
+    }
+}
+
+/// `mpris:length` is an int64 by the specification, but some players send uint64.
+fn track_length(value: &OwnedValue) -> Option<u64> {
+    let value = value.try_clone().ok()?;
+    i64::try_from(&value)
+        .ok()
+        .and_then(|micros| u64::try_from(micros).ok())
+        .or_else(|| u64::try_from(&value).ok())
+}
+
+fn gsettings_flag(schema: &str, key: &str) -> Option<bool> {
+    let output = Process::new("gsettings").args(["get", schema, key]).output().ok()?;
+    match std::str::from_utf8(&output.stdout).ok()?.trim() {
+        "true" => Some(true),
+        "false" => Some(false),
+        _ => None,
+    }
+}
+
+fn read_number(path: &Path) -> Option<u64> {
+    std::fs::read_to_string(path).ok()?.trim().parse().ok()
+}
+
+/// Level in percent, rounded like the provider script.
+fn backlight_percent(dir: &Path) -> Option<u8> {
+    let level = read_number(&dir.join("brightness"))?;
+    let maximum = read_number(&dir.join("max_brightness")).filter(|maximum| *maximum > 0)?;
+    u8::try_from(((level * 100 + maximum / 2) / maximum).min(100)).ok()
+}
+
+/// Keeps the shared audio state up to date; reconnects after any failure.
+fn audio_thread(shared: &Mutex<Option<AudioState>>) {
+    loop {
+        if let Err(error) = follow_audio(shared) {
+            eprintln!("t1-touchbar: native audio status: {error}");
+        }
+        if let Ok(mut state) = shared.lock() {
+            *state = None;
+        }
+        thread::sleep(AUDIO_RETRY);
+    }
+}
+
+type AudioResult<T> = Result<T, Box<dyn std::error::Error>>;
+
+struct PulseConnection {
+    socket: BufReader<UnixStream>,
+    version: u16,
+    sequence: u32,
+}
+
+impl PulseConnection {
+    fn open(name: &str) -> AudioResult<Self> {
+        let path = pulseaudio::socket_path_from_env().ok_or("no sound server socket")?;
+        let mut socket = BufReader::new(UnixStream::connect(path)?);
+        let cookie = pulseaudio::cookie_path_from_env()
+            .and_then(|path| std::fs::read(path).ok())
+            .unwrap_or_default();
+        protocol::write_command_message(
+            socket.get_mut(),
+            0,
+            &Command::Auth(protocol::AuthParams {
+                version: protocol::MAX_VERSION,
+                supports_shm: false,
+                supports_memfd: false,
+                cookie,
+            }),
+            protocol::MAX_VERSION,
+        )?;
+        let (_, reply) =
+            protocol::read_reply_message::<protocol::AuthReply>(&mut socket, protocol::MAX_VERSION)?;
+        let version = protocol::MAX_VERSION.min(reply.version);
+        let mut props = protocol::Props::new();
+        props.set(Prop::ApplicationName, CString::new(name)?);
+        protocol::write_command_message(socket.get_mut(), 1, &Command::SetClientName(props), version)?;
+        protocol::read_reply_message::<protocol::SetClientNameReply>(&mut socket, version)?;
+        Ok(Self {
+            socket,
+            version,
+            sequence: 2,
+        })
+    }
+
+    fn send(&mut self, command: &Command) -> AudioResult<()> {
+        self.sequence = self.sequence.wrapping_add(1);
+        protocol::write_command_message(self.socket.get_mut(), self.sequence, command, self.version)?;
+        Ok(())
+    }
+
+    fn query<T: protocol::CommandReply>(&mut self, command: &Command) -> AudioResult<T> {
+        self.send(command)?;
+        let (_, reply) = protocol::read_reply_message::<T>(&mut self.socket, self.version)?;
+        Ok(reply)
+    }
+}
+
+/// `T1_NATIVE_DEBUG=1` traces every sound server event and the state read after it.
+fn follow_audio(shared: &Mutex<Option<AudioState>>) -> AudioResult<()> {
+    let debug = std::env::var_os("T1_NATIVE_DEBUG").is_some();
+    let mut events = PulseConnection::open("t1-touchbar events")?;
+    let mut queries = PulseConnection::open("t1-touchbar")?;
+    events.send(&Command::Subscribe(
+        SubscriptionMask::SINK
+            | SubscriptionMask::SOURCE
+            | SubscriptionMask::SOURCE_OUTPUT
+            | SubscriptionMask::SERVER,
+    ))?;
+    protocol::read_ack_message(&mut events.socket)?;
+    loop {
+        let state = read_audio(&mut queries)?;
+        if debug {
+            eprintln!("t1-touchbar: native audio {state:?}");
+        }
+        if let Ok(mut shared) = shared.lock() {
+            *shared = Some(state);
+        }
+        // sleeps here until the server reports a change
+        let (_, event) = protocol::read_command_message(&mut events.socket, events.version)?;
+        if debug {
+            eprintln!("t1-touchbar: native audio event {event:?}");
+        }
+        if !matches!(event, Command::SubscribeEvent(_)) {
+            continue;
+        }
+    }
+}
+
+fn read_audio(connection: &mut PulseConnection) -> AudioResult<AudioState> {
+    let server = connection.query::<protocol::ServerInfo>(&Command::GetServerInfo)?;
+    let sink_name = server.default_sink_name.ok_or("no default sink")?;
+    let sink = connection.query::<protocol::SinkInfo>(&Command::GetSinkInfo(protocol::GetSinkInfo {
+        index: None,
+        name: Some(sink_name),
+    }))?;
+    let volume = sink
+        .cvolume
+        .channels()
+        .iter()
+        .map(protocol::Volume::as_u32)
+        .max()
+        .unwrap_or(0);
+    let mic_muted = match server.default_source_name {
+        Some(name) => connection
+            .query::<protocol::SourceInfo>(&Command::GetSourceInfo(protocol::GetSourceInfo {
+                index: None,
+                name: Some(name),
+            }))
+            .ok()
+            .map(|source| source.muted),
+        None => None,
+    };
+    let effects_present = connection
+        .query::<protocol::SinkInfo>(&Command::GetSinkInfo(protocol::GetSinkInfo {
+            index: None,
+            name: Some(CString::new("easyeffects_sink")?),
+        }))
+        .is_ok();
+    let call = connection
+        .query::<protocol::SourceOutputInfoList>(&Command::GetSourceOutputInfoList)
+        .ok()
+        .and_then(|outputs| outputs.iter().find_map(call_app));
+    Ok(AudioState {
+        volume: u8::try_from((u64::from(volume) * 100 + 0x8000) / 0x1_0000)
+            .unwrap_or(100)
+            .min(100),
+        muted: sink.muted,
+        mic_muted,
+        kind: output_kind(&sink),
+        effects_present,
+        call,
+    })
+}
+
+fn prop_text(props: &protocol::Props, prop: Prop) -> String {
+    props
+        .get(prop)
+        .map(|bytes| String::from_utf8_lossy(bytes).trim_end_matches('\0').to_owned())
+        .unwrap_or_default()
+}
+
+/// Recording streams that are not calls: level meters, speech, sound effects.
+const NOT_CALLS: [&str; 6] = [
+    "easyeffects",
+    "gnome-control-center",
+    "gnome settings",
+    "pavucontrol",
+    "speech-dispatcher",
+    "t1-touchbar",
+];
+
+/// Application behind a recording stream, `None` for streams that are not calls.
+fn call_app(output: &protocol::SourceOutputInfo) -> Option<CallApp> {
+    let name = prop_text(&output.props, Prop::ApplicationName).to_lowercase();
+    let id = prop_text(&output.props, Prop::ApplicationId).to_lowercase();
+    let binary = prop_text(&output.props, Prop::ApplicationProcessBinary).to_lowercase();
+    let media = prop_text(&output.props, Prop::MediaName);
+    let everything = format!("{name} {id} {binary}");
+    if NOT_CALLS.iter().any(|skip| everything.contains(skip)) {
+        return None;
+    }
+    Some(classify_call(&everything, &media))
+}
+
+/// Call application from the stream's application fields and media (tab) name.
+fn classify_call(application: &str, media: &str) -> CallApp {
+    let media_lower = media.to_lowercase();
+    if media.starts_with("Meet ") || media_lower.contains("google meet") {
+        CallApp::Meet
+    } else if application.contains("talk") || media_lower.contains("nextcloud talk") {
+        CallApp::Talk
+    } else if application.contains("karere") || application.contains("whatsapp") || media_lower.contains("whatsapp") {
+        CallApp::WhatsApp
+    } else if application.contains("teams") || media_lower.contains("teams") {
+        CallApp::Teams
+    } else if application.contains("zoom") || media_lower.contains("zoom") {
+        CallApp::Zoom
+    } else if application.contains("firefox") {
+        CallApp::Firefox
+    } else if application.contains("chrom") {
+        CallApp::Chromium
+    } else {
+        CallApp::Other
+    }
+}
+
+fn output_kind(sink: &protocol::SinkInfo) -> OutputKind {
+    let name = sink.name.to_bytes();
+    let bus = sink.props.get(Prop::DeviceBus).unwrap_or_default();
+    let port = sink
+        .ports
+        .get(sink.active_port)
+        .map(|port| port.name.to_bytes())
+        .unwrap_or_default();
+    if name.starts_with(b"bluez_output") || bus.starts_with(b"bluetooth") {
+        OutputKind::Bluetooth
+    } else if bus.starts_with(b"usb") || name.starts_with(b"alsa_output.usb") {
+        OutputKind::Usb
+    } else if port.windows(10).any(|window| window == b"headphones") {
+        OutputKind::Headphones
+    } else {
+        OutputKind::Speakers
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use zbus::zvariant::Value;
+
+    #[test]
+    fn calls_are_recognised_from_the_stream_fields() {
+        assert_eq!(classify_call("firefox  firefox-esr", "Meet – unx-kgng-cja"), CallApp::Meet);
+        assert_eq!(classify_call("firefox  firefox-esr", "Some page"), CallApp::Firefox);
+        assert_eq!(
+            classify_call("nextcloud talk com.nextcloud.talk nextcloud talk", "WebRTC"),
+            CallApp::Talk
+        );
+        assert_eq!(classify_call("karere  karere", "Playback"), CallApp::WhatsApp);
+        assert_eq!(classify_call("chromium  chromium", "Microsoft Teams"), CallApp::Teams);
+        assert_eq!(classify_call("chromium  chromium", "x"), CallApp::Chromium);
+        assert_eq!(classify_call("obs  obs", "mic"), CallApp::Other);
+    }
+
+    #[test]
+    fn track_length_accepts_signed_and_unsigned_microseconds() {
+        let signed = OwnedValue::try_from(Value::I64(180_000_000)).unwrap();
+        let unsigned = OwnedValue::try_from(Value::U64(240_000_000)).unwrap();
+        let negative = OwnedValue::try_from(Value::I64(-1)).unwrap();
+        assert_eq!(track_length(&signed), Some(180_000_000));
+        assert_eq!(track_length(&unsigned), Some(240_000_000));
+        assert_eq!(track_length(&negative), None);
+    }
+}
