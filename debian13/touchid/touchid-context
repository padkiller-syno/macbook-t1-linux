#!/bin/sh
# Contexte d'une demande Touch ID, affiché par la Touch Bar pendant l'attente du doigt.
# Appelé par pam_exec juste avant pam_fprintd : « touchid-context <essais> <délai en s> ».
# Écrit /run/t1bridge/touch-id-context (root:t1bridge 0640) ; sort toujours en 0 pour ne
# jamais gêner l'authentification.
OUT=/run/t1bridge/touch-id-context
[ -d /run/t1bridge ] || exit 0
user=${PAM_USER:-?}
case "${PAM_SERVICE:-}" in
  sudo|sudo-i)
    # le parent de ce script est le processus sudo lui-même : sa ligne de commande dit ce qu'on autorise
    cmd=$(tr '\0' ' ' </proc/$PPID/cmdline 2>/dev/null)
    cmd=${cmd#sudo }; cmd=${cmd% }
    label="sudo : ${cmd:-commande}" ;;
  su|su-l) label="su : devenir $user" ;;
  polkit-1) label="Autorisation administrateur (polkit)" ;;
  gdm-fingerprint|gdm-password)
    uid=$(id -u "$user" 2>/dev/null)
    if [ -n "$uid" ] && [ -d "/run/user/$uid" ]; then label="Déverrouiller la session de $user"
    else label="Ouvrir la session de $user"; fi ;;
  login) label="Connexion console de $user" ;;
  *) label="${PAM_SERVICE:-authentification} : $user" ;;
esac
label=$(printf '%s' "$label" | tr -d '\000-\037\177' | head -c 400)
tmp=$OUT.$$
{
  printf 'ts=%s\n' "$(date +%s)"
  printf 'label=%s\n' "$label"
  printf 'tries=%s\n' "${1:-3}"
  printf 'timeout=%s\n' "${2:-30}"
} >"$tmp" 2>/dev/null && chgrp t1bridge "$tmp" 2>/dev/null && chmod 640 "$tmp" && mv -f "$tmp" "$OUT"
rm -f "$tmp" 2>/dev/null
exit 0
