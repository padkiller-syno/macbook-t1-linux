diff --git a/pm/powerplay/smumgr/polaris10_smumgr.c b/pm/powerplay/smumgr/polaris10_smumgr.c
index e59b872..ddbf404 100644
--- a/pm/powerplay/smumgr/polaris10_smumgr.c
+++ b/pm/powerplay/smumgr/polaris10_smumgr.c
@@ -289,13 +289,59 @@ static int polaris10_start_smu_in_non_protection_mode(struct pp_hwmgr *hwmgr)
 	return result;
 }
 
+/*
+ * t1 (MacBookPro13,3) : après une coupure d'alimentation par le firmware Apple (veille S3) ou un
+ * reset PCI, le SMC peut sembler « en marche » alors qu'il ne répond plus au chargement des
+ * microcodes (UcodeLoadStatus reste à 0). amdgpu.t1_smc_restart=1 : en cas d'échec, remettre le
+ * SMC à zéro, recharger son firmware et réessayer une fois.
+ */
+static int t1_smc_restart = 1;
+module_param(t1_smc_restart, int, 0644);
+MODULE_PARM_DESC(t1_smc_restart, "t1: force SMC restart when ucode loading fails (Polaris, 1 = on)");
+
+static void t1_smc_state(struct pp_hwmgr *hwmgr, const char *when)
+{
+	pr_info("amdgpu-t1: %s: smc_running=%d pc=0x%08x ck_disable=%u smu_firmware=0x%08x rcu_uc_events=0x%08x firmware_flags=0x%08x smu_status=0x%08x\n",
+		when, smu7_is_smc_ram_running(hwmgr),
+		cgs_read_ind_register(hwmgr->device, CGS_IND_REG__SMC, ixSMC_PC_C),
+		PHM_READ_VFPF_INDIRECT_FIELD(hwmgr->device, CGS_IND_REG__SMC, SMC_SYSCON_CLOCK_CNTL_0, ck_disable),
+		cgs_read_ind_register(hwmgr->device, CGS_IND_REG__SMC, ixSMU_FIRMWARE),
+		cgs_read_ind_register(hwmgr->device, CGS_IND_REG__SMC, ixRCU_UC_EVENTS),
+		cgs_read_ind_register(hwmgr->device, CGS_IND_REG__SMC, ixFIRMWARE_FLAGS),
+		cgs_read_ind_register(hwmgr->device, CGS_IND_REG__SMC, ixSMU_STATUS));
+}
+
+static int t1_polaris10_boot_smc(struct pp_hwmgr *hwmgr)
+{
+	struct polaris10_smumgr *smu_data = (struct polaris10_smumgr *)(hwmgr->smu_backend);
+	int result;
+
+	smu_data->protected_mode = (uint8_t) (PHM_READ_VFPF_INDIRECT_FIELD(hwmgr->device, CGS_IND_REG__SMC, SMU_FIRMWARE, SMU_MODE));
+	smu_data->smu7_data.security_hard_key = (uint8_t) (PHM_READ_VFPF_INDIRECT_FIELD(hwmgr->device, CGS_IND_REG__SMC, SMU_FIRMWARE, SMU_SEL));
+	pr_info("amdgpu-t1: boot SMC, protected_mode=%u\n", smu_data->protected_mode);
+
+	if (smu_data->protected_mode == 0)
+		result = polaris10_start_smu_in_non_protection_mode(hwmgr);
+	else
+		result = polaris10_start_smu_in_protection_mode(hwmgr);
+	if (result)
+		return result;
+
+	polaris10_avfs_event_mgr(hwmgr);
+	return 0;
+}
+
 static int polaris10_start_smu(struct pp_hwmgr *hwmgr)
 {
 	int result = 0;
 	struct polaris10_smumgr *smu_data = (struct polaris10_smumgr *)(hwmgr->smu_backend);
+	bool booted = false;
+
+	t1_smc_state(hwmgr, "start_smu");
 
 	/* Only start SMC if SMC RAM is not running */
 	if (!smu7_is_smc_ram_running(hwmgr) && hwmgr->not_vf) {
+		booted = true;
 		smu_data->protected_mode = (uint8_t) (PHM_READ_VFPF_INDIRECT_FIELD(hwmgr->device, CGS_IND_REG__SMC, SMU_FIRMWARE, SMU_MODE));
 		smu_data->smu7_data.security_hard_key = (uint8_t) (PHM_READ_VFPF_INDIRECT_FIELD(hwmgr->device, CGS_IND_REG__SMC, SMU_FIRMWARE, SMU_SEL));
 
@@ -309,6 +355,7 @@ static int polaris10_start_smu(struct pp_hwmgr *hwmgr)
 			PP_ASSERT_WITH_CODE(0, "Failed to load SMU ucode.", return result);
 
 		polaris10_avfs_event_mgr(hwmgr);
+		t1_smc_state(hwmgr, "after SMC boot");
 	}
 
 	/* Setup SoftRegsStart here for register lookup in case DummyBackEnd is used and ProcessFirmwareHeader is not executed */
@@ -316,7 +363,23 @@ static int polaris10_start_smu(struct pp_hwmgr *hwmgr)
 					&(smu_data->smu7_data.soft_regs_start), 0x40000);
 
 	result = smu7_request_smu_load_fw(hwmgr);
+	if (!result || !t1_smc_restart || !hwmgr->not_vf)
+		return result;
 
+	/* t1 : SMC muet, on le redémarre de force (même si on vient de le démarrer) puis on réessaie */
+	t1_smc_state(hwmgr, booted ? "ucode load failed after SMC boot" : "ucode load failed, SMC was running");
+	PHM_WRITE_VFPF_INDIRECT_FIELD(hwmgr->device, CGS_IND_REG__SMC, SMC_SYSCON_RESET_CNTL, rst_reg, 1);
+	PHM_WRITE_VFPF_INDIRECT_FIELD(hwmgr->device, CGS_IND_REG__SMC, SMC_SYSCON_CLOCK_CNTL_0, ck_disable, 1);
+	result = t1_polaris10_boot_smc(hwmgr);
+	t1_smc_state(hwmgr, "after forced SMC restart");
+	if (result) {
+		pr_err("amdgpu-t1: forced SMC restart failed (%d)\n", result);
+		return result;
+	}
+	smu7_read_smc_sram_dword(hwmgr, SMU7_FIRMWARE_HEADER_LOCATION + offsetof(SMU74_Firmware_Header, SoftRegisters),
+					&(smu_data->smu7_data.soft_regs_start), 0x40000);
+	result = smu7_request_smu_load_fw(hwmgr);
+	pr_info("amdgpu-t1: ucode load retry after SMC restart: %s (%d)\n", result ? "FAILED" : "OK", result);
 	return result;
 }
 
