diff --git a/amdgpu/amdgpu_device.c b/amdgpu/amdgpu_device.c
index ea9a6ed..04b541f 100644
--- a/amdgpu/amdgpu_device.c
+++ b/amdgpu/amdgpu_device.c
@@ -4783,10 +4783,19 @@ int amdgpu_device_resume(struct drm_device *dev, bool notify_clients)
 		amdgpu_dpm_gfx_state_change(adev, sGpuChangeState_D0Entry);
 
 	/* post card */
-	if (amdgpu_device_need_post(adev)) {
-		r = amdgpu_device_asic_init(adev);
-		if (r)
-			dev_err(adev->dev, "amdgpu asic init failed\n");
+	{
+		/* t1 : trace de l'état de la carte au réveil (MacBookPro13,3) */
+		u32 t1_s7 = adev->bios_scratch_reg_offset ? RREG32(adev->bios_scratch_reg_offset + 7) : 0;
+		bool t1_post = amdgpu_device_need_post(adev);
+
+		dev_info(adev->dev, "amdgpu-t1: resume need_post=%d bios_scratch7=0x%08x memsize=0x%08x in_s0ix=%d in_s3=%d\n",
+			 t1_post, t1_s7, amdgpu_asic_get_config_memsize(adev), adev->in_s0ix, adev->in_s3);
+		if (t1_post) {
+			r = amdgpu_device_asic_init(adev);
+			dev_info(adev->dev, "amdgpu-t1: asic_init -> %d\n", r);
+			if (r)
+				dev_err(adev->dev, "amdgpu asic init failed\n");
+		}
 	}
 
 	r = amdgpu_device_ip_resume(adev);
