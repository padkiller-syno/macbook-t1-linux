 	pr_err("SMU load firmware failed\n");
+	pr_err("amdgpu-t1: UcodeLoadStatus=0x%08x wanted=0x%08x soft_regs_start=0x%08x\n",
+	       cgs_read_ind_register(hwmgr->device, CGS_IND_REG__SMC,
+				     smu_data->soft_regs_start + smum_get_offsetof(hwmgr,
+				     SMU_SoftRegisters, UcodeLoadStatus)),
+	       fw_to_load, smu_data->soft_regs_start);
+	pr_err("amdgpu-t1: header_buffer mc=0x%llx smu_buffer mc=0x%llx fw_buf mc=0x%llx vram_start=0x%llx gart_start=0x%llx\n",
+	       smu_data->header_buffer.mc_addr, smu_data->smu_buffer.mc_addr,
+	       ((struct amdgpu_device *)hwmgr->adev)->firmware.fw_buf_mc, ((struct amdgpu_device *)hwmgr->adev)->gmc.vram_start, ((struct amdgpu_device *)hwmgr->adev)->gmc.gart_start);
 
 failed:
 	kfree(smu_data->toc);
