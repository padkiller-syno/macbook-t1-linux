#!/bin/sh
# MacBook Pro T2 (MacBookPro15,1, i7-8750H base 2,2 GHz / turbo 4,1 GHz, Radeon Pro 555X) :
# applique le profil power-profiles-daemon (choisi par Plasma ou la Touch Bar) au CPU et à la Radeon.
# Réglages issus de la mesure sur batterie du 20/11 (kubuntu-t2/energie/resultats-20261120-145835.txt) :
#   économie    : 2200 MHz sans turbo, EPP balance_performance (20,8 s / 962 J, le moins d'énergie par tâche ;
#                 l'EPP « power » de power-profiles-daemon donnait 36,9 s / 1 198 J) ;
#   équilibré   : 3000 MHz avec turbo, EPP balance_performance (16,1 s / 1 023 J) ;
#   performance : turbo complet, EPP de power-profiles-daemon (performance) (15,0 s / 1 186 J).
# Radeon : auto en performance ou avec un écran externe, low sinon (après 3 relevés, 9 s).
# power-profiles-daemon réécrit l'EPP à chaque changement de profil : il est réimposé ici à chaque relevé.
# Installé dans /usr/local/sbin, lancé par profil-energie-sync.service. Source : dépôt macbook-t1-linux, kubuntu-t2/energie/.
PP="org.freedesktop.UPower.PowerProfiles /org/freedesktop/UPower/PowerProfiles org.freedesktop.UPower.PowerProfiles"
CPU=/sys/devices/system/cpu
T=$CPU/intel_pstate/no_turbo
MAX=$(cat $CPU/cpu0/cpufreq/cpuinfo_max_freq)
lows=0
while :; do
  P=$(busctl get-property $PP ActiveProfile 2>/dev/null | awk -F'"' '{print $2}')
  # --- CPU ---
  case "$P" in
    power-saver) nt=1; mx=2200000; epp=balance_performance ;;
    balanced)    nt=0; mx=3000000; epp=balance_performance ;;
    performance) nt=0; mx=$MAX;    epp= ;;
    *)           nt=; mx=; epp= ;;
  esac
  if [ -n "$nt" ]; then
    [ "$(cat $T)" = $nt ] || { echo $nt > $T && logger -t profil-energie-sync "cpu: turbo $([ $nt = 0 ] && echo activé || echo coupé) (profil=$P)"; }
    if [ "$(cat $CPU/cpu0/cpufreq/scaling_max_freq)" != "$mx" ]; then
      for m in $CPU/cpu[0-9]*/cpufreq/scaling_max_freq; do echo $mx > $m; done
      logger -t profil-energie-sync "cpu: max $((mx / 1000)) MHz (profil=$P)"
    fi
    if [ -n "$epp" ] && [ "$(cat $CPU/cpu0/cpufreq/energy_performance_preference)" != "$epp" ]; then
      for e in $CPU/cpu[0-9]*/cpufreq/energy_performance_preference; do echo $epp > $e; done
      logger -t profil-energie-sync "cpu: EPP $epp (profil=$P)"
    fi
  fi
  # --- Radeon ---
  for d in /sys/class/drm/card[0-9]; do
    [ "$(basename "$(readlink -f $d/device/driver)")" = amdgpu ] || continue
    ext=0
    for c in $d-*; do
      case "$c" in *eDP*) continue ;; esac
      [ "$(cat $c/status 2>/dev/null)" = connected ] && ext=1
    done
    f=$d/device/power_dpm_force_performance_level; cur=$(cat $f)
    if [ "$P" = performance ] || [ $ext = 1 ]; then
      lows=0
      [ "$cur" = auto ] || { echo auto > $f && logger -t profil-energie-sync "$(basename $d): auto (profil=${P:-?} externe=$ext)"; }
    else
      lows=$((lows + 1))
      [ $lows -ge 3 ] && [ "$cur" != low ] && echo low > $f && logger -t profil-energie-sync "$(basename $d): low (profil=${P:-?})"
    fi
  done
  sleep 3
done
